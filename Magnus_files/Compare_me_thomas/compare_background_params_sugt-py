def run(Cls, p, label):
    print(f"\n=== Running {label} ===")
    c = Cls()
    c.set(p)
    c.compute()
    return c

def pk_safe(cosmo, k, z):
    if hasattr(cosmo, "pk_lin"):
        return cosmo.pk_lin(k, z)
    return cosmo.pk(k, z)

# -------------------------
# debug helpers
# -------------------------
def print_param_diff(pA, pB, nameA="A", nameB="B"):
    keys = sorted(set(pA.keys()) | set(pB.keys()))
    diffs = []
    for k in keys:
        vA = pA.get(k, "<missing>")
        vB = pB.get(k, "<missing>")
        if vA != vB:
            diffs.append((k, vA, vB))
    if diffs:
        print(f"\n--- Input param diffs ({nameA} vs {nameB}) ---")
        for k, vA, vB in diffs:
            print(f"{k:28s}  {nameA}: {vA}   |   {nameB}: {vB}")
    else:
        print(f"\n--- Input param diffs ({nameA} vs {nameB}) --- none")

def safe_get(c, fn_name, default=np.nan):
    try:
        fn = getattr(c, fn_name)
        return fn()
    except Exception:
        return default

def dump_derived(c, label):
    # These are "derived" getters from CLASS objects
    # (availability depends a bit on build/wrapper, so we guard each call)
    out = {
        "h": safe_get(c, "h"),
        "Omega_m": safe_get(c, "Omega_m"),
        "Omega_r": safe_get(c, "Omega_r"),
        "Omega0_cdm": safe_get(c, "Omega0_cdm"),
        "Omega0_b": safe_get(c, "Omega_b"),  # some wrappers use Omega_b() not Omega0_b()
        "Omega_Lambda": safe_get(c, "Omega_Lambda"),
        "Neff": safe_get(c, "Neff"),
        "z_eq": safe_get(c, "z_eq"),
        "tau0": safe_get(c, "tau0"),
        "age": safe_get(c, "age"),
        "rs_drag": safe_get(c, "rs_drag"),
        "sigma8": safe_get(c, "sigma8"),
    }

    # also add Omega_ncdm if the wrapper exposes it
    for cand in ["Omega_ncdm", "Omega0_ncdm"]:
        val = safe_get(c, cand, None)
        if val is not None and not (isinstance(val, float) and np.isnan(val)):
            out[cand] = val

    print(f"\n--- Derived quantities ({label}) ---")
    for k, v in out.items():
        print(f"{k:14s} = {v}")
    return out

def bg_at_z(c, z):
    """
    Use background table; keys differ slightly by build.
    We'll print what exists among a common shortlist.
    """
    bg = c.get_background()

    # pick representative columns if present
    wanted = [
        "z",
        "H [1/Mpc]",
        "H [km/s/Mpc]",
        "(.)rho_tot",
        "(.)rho_g",
        "(.)rho_b",
        "(.)rho_cdm",
        "(.)rho_ur",
        "(.)rho_ncdm",
        "(.)Omega_m",
        "(.)Omega_r",
        "(.)Omega_ncdm",
    ]

    # CLASS background table is arrays; we need nearest z index
    z_arr = np.array(bg["z"])
    idx = int(np.argmin(np.abs(z_arr - z)))

    row = {"z_req": z, "z_hit": float(z_arr[idx]), "idx": idx}
    for k in wanted:
        if k in bg:
            row[k] = float(np.array(bg[k])[idx])

    return row, bg

def print_bg_rows(row, label):
    print(f"\n--- Background @ z≈{row['z_req']} ({label}) ---")
    print(f"hit z = {row['z_hit']}  (idx={row['idx']})")
    for k, v in row.items():
        if k in ["z_req", "z_hit", "idx"]:
            continue
        print(f"{k:14s} = {v}")

def compare_dicts(dA, dB, labelA="A", labelB="B", rtol=1e-8, atol=0.0):
    print(f"\n--- Compare derived ({labelA} vs {labelB}) ---")
    keys = sorted(set(dA.keys()) & set(dB.keys()))
    bad = 0
    for k in keys:
        a = dA[k]
        b = dB[k]
        # skip NaNs
        if isinstance(a, float) and np.isnan(a):
            continue
        if isinstance(b, float) and np.isnan(b):
            continue
        ok = np.isclose(a, b, rtol=rtol, atol=atol)
        if not ok:
            bad += 1
            print(f"DIFF {k:14s}: {labelA}={a}  {labelB}={b}   (rel={(a-b)/b if b!=0 else np.nan})")
    if bad == 0:
        print("All overlapping derived quantities match within tolerance.")

